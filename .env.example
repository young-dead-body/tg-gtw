# Копировать в .env и скорректировать под окружение.
# Никогда не коммитить реальные секреты.

# ===== PostgreSQL =====
POSTGRES_USER=tg
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=telegram_gateway
# DSN для api / миграций (внутри compose-сети).
POSTGRES_DSN=postgres://tg:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/telegram_gateway

# ===== Redis =====
# Адрес для api / бота / прокси (внутри compose-сети).
REDIS_ADDR=redis:6379

# ===== API =====
# Порт прослушивания api.
PORT=8080
# Внешний базовый URL шлюза (для бота и ссылок).
GATEWAY_URL=https://localhost
# Общий секрет между API и ботом (Authorization: Bearer на /bot/*).
BOT_API_TOKEN=REPLACE_WITH_BOT_API_TOKEN
# Первый администратор создаётся автоматически. Логин и пароль выводятся
# только при первом запуске API: docker compose logs api.
# Интервалы cron-сканов (Go duration: 24h, 6h...). Опционально.
# PASSWORD_EXPIRY_CRON_INTERVAL=24h
# ACCESS_EXPIRY_CRON_INTERVAL=6h

# ===== Cron: чистка / архивация / бэкапы (S16) =====
# Периодичность чистки просроченных сессий и устаревших заявок.
CLEANUP_CRON_INTERVAL=24h
# Возраст заявок (pending/rejected), после которого они удаляются.
CLEANUP_REQUEST_AGE=720h
# Периодичность архивации audit_log в audit_log_archive.
ARCHIVE_CRON_INTERVAL=24h
# Возраст логов, старше которого они переносятся в архив.
ARCHIVE_LOG_AGE=2160h
# Периодичность pg_dump-бэкапов и директория/число хранимых копий.
BACKUP_CRON_INTERVAL=24h
BACKUP_KEEP=7
# BACKUP_DIR=/backups

# ===== Telegram Bot (S11) =====
# Включить функциональность tg-bot целиком (контейнер, /bot/*, события,
# поле telegram в UI). Значение задаётся на хосте и сеется в таблицу settings
# при старте API (дефолт); затем может быть переопределено на лету через
# админ-API /settings/telegram.bot.
TG_BOT_ENABLED=true
# Токен бота от @BotFather. Без него бот не стартует.
BOT_TOKEN=
# Канал событий Redis (если отличается от дефолтного).
# EVENTS_CHANNEL=gateway:events

# ===== Reverse Proxy (S10) =====
# PROXY_ADDR=:8080
# SOCKS5-шлюз к Telegram: весь трафик /tg/* и health-check бэкендов идут через
# него. Пусто = прямой доступ (требуется маршрут до web.telegram.org).
# SOCKS5_ADDR=127.0.0.1:20170
# TLS-passthrough для клиентских MTProto-соединений Telegram Web: браузер
# идёт на *.web.telegram.org:443, хост-порт 443 пробрасывается на этот
# листенер, SNI уводится через SOCKS5 к реальному Telegram (TLS end-to-end).
# TG_PASSTHROUGH_ADDR=:9443

# ===== DC-мост: переписывание dc_options и bootstrap WS (QR-вход) =====
# Два режима (взаимоисключающие, DC_REWRITE_DOMAIN имеет приоритет):
#
# 1) Режим SNI-роутинга (рекомендуется: работает из сетей, где открыт только
#    порт 443 — корпоративные сети РФ и т.п.). dc_options и bootstrap WS
#    переписываются на dc<N>.<домен>:443, VPS-nginx выбирает DC-мост по SNI.
#    Требуются A-записи dc1..dc5.<домен> -> VPS и LE-сертификат с этими SAN
#    (см. docs/dns-regru.md, infra/frp/vps-nginx-web-tgk.conf):
# DC_REWRITE_DOMAIN=gateway.example.com
# DC_BRIDGE_WSS_1=dc1.gateway.example.com
# DC_BRIDGE_WSS_2=dc2.gateway.example.com
# DC_BRIDGE_WSS_3=dc3.gateway.example.com
# DC_BRIDGE_WSS_4=dc4.gateway.example.com
# DC_BRIDGE_WSS_5=dc5.gateway.example.com
#
# 2) Legacy-режим (LAN): все DC указывают на DC_REWRITE_IP, порт
#    DC_PORT_BASE+dc_id (браузер ходит на 20001..20005):
# DC_REWRITE_IP=127.0.0.1
# DC_PORT_BASE=20000
# DC_BRIDGE_WSS_1=127.0.0.1:20001
# DC_BRIDGE_WSS_2=127.0.0.1:20002
# DC_BRIDGE_WSS_3=127.0.0.1:20003
# DC_BRIDGE_WSS_4=127.0.0.1:20004
# DC_BRIDGE_WSS_5=127.0.0.1:20005

# ===== TURN-релей для звонков Telegram Web =====
# Медиа звонков (WebRTC) из заблокированных сетей не доходит до TURN Telegram,
# звонок висит на «Соединение…». telegram-proxy поднимает свой TURN (TCP),
# медиа выходит через SOCKS5_ADDR (нужна поддержка UDP ASSOCIATE). Браузер
# получает сервер через /tg/_gw/rtc.js. Цепочка: turns:turn.<домен>:443 ->
# VPS nginx (stream, SNI, TLS) -> frp -> 127.0.0.1:3478.
# Секрет: openssl rand -hex 32. Пустой TURN_ADDR — релей выключен.
# TURN_ADDR=:3478
# TURN_SECRET=
# TURN_URLS=turns:turn.gateway.example.com:443?transport=tcp
# TURN_STUN_SERVER=stun.cloudflare.com:3478
# TURN_PUBLIC_IP=           # fallback, если STUN через SOCKS не ответил
# TURN_CREDENTIAL_TTL=12h
# TURN_RELAY_ONLY=false     # true — только relay-кандидаты (без host/srflx)

# ===== Геолокация по IP (S12) =====
# Путь к GeoLite2-City.mmdb внутри контейнера api. Если пусто —
# гео-поля статистики (страна/регион/город) остаются NULL.
GEOIP_DB=/geo/GeoLite2-City.mmdb

# ===== Rate limit / блокировка (S15) =====
# Значение 0 отключает соответствующую защиту.
# Общий лимит запросов на IP (окно).
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=1m
# Лимит попыток входа на IP.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=1m
# Лимит заявок на регистрацию на IP.
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW=1m
# Блокировка brute force: порог неудачных попыток (IP и email) и окно.
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW=15m

# ===== Мониторинг / логи (S17) =====
# Адрес метрик API (порт для Prometheus) и адрес telegram-proxy (доступность).
METRICS_ADDR=:9091
TELEGRAM_PROXY_ADDR=telegram-proxy:8080
# PROXY_METRICS_ADDR=:9092
# Уровень zap-логов и файл для shipped-в-Loki логов (LOG_FILE).
LOG_LEVEL=info
# LOG_FILE=/logs/app.log

# ===== Grafana =====
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD

# ===== Nginx (опционально, по умолчанию подставляются сервисы compose) =====
# API_UPSTREAM=api:8080
# WEB_UPSTREAM=web:80
# TG_UPSTREAM=telegram-proxy:8080
# TLS_CERT=/etc/nginx/certs/server.crt
# TLS_KEY=/etc/nginx/certs/server.key

# Optional encrypted offsite backups. Initialize the restic repository first.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
