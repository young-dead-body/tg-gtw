# ./scripts/install.sh creates .env and fills random service secrets.
# The gateway administrator password is generated by the API on first start.
DOMAIN=
ACME_EMAIL=
COMPOSE_FILE=docker-compose.yml
POSTGRES_USER=tg
POSTGRES_DB=telegram_gateway
POSTGRES_PASSWORD=
BOT_API_TOKEN=

# Direct VPS access to Telegram: leave both proxy settings empty.
SOCKS5_ADDR=
BOT_HTTPS_PROXY=

# Optional bot: set all three values.
TG_BOT_ENABLED=false
BOT_TOKEN=
COMPOSE_PROFILES=

# Optional TURN relay requires a SOCKS5 server with UDP ASSOCIATE.
# Direct egress cannot use this relay.
TURN_ADDR=
TURN_SECRET=
TURN_URLS=
TURN_PUBLIC_IP=

BACKUP_KEEP=7
BACKUP_CRON_INTERVAL=24h
CLEANUP_CRON_INTERVAL=24h
CLEANUP_REQUEST_AGE=720h
ARCHIVE_CRON_INTERVAL=24h
ARCHIVE_LOG_AGE=2160h
LOG_LEVEL=info
