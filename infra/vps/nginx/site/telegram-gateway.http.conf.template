# Системный nginx VPS: внешний вход шлюза для ${DOMAIN}
# (scripts/vps/setup-nginx.sh -> /etc/nginx/sites-enabled/telegram-gateway).
#
# Порт 443 принимает stream-маршрутизатор (telegram-gateway.stream.conf) и по
# SNI передаёт соединения сюда, на 127.0.0.1:4443, с PROXY protocol.
# Upstream'ы (webtgk_up, tgk_dc1..5) задаёт переключатель
# /etc/nginx/conf.d/zz-webtgk-target.conf (scripts/vps/switch-ingress.sh).

# DC-мост Telegram Web: SNI dc<N>.${DOMAIN} -> DC-мост N.
map $ssl_server_name $dc_upstream {
    dc1.${DOMAIN} tgk_dc1;
    dc2.${DOMAIN} tgk_dc2;
    dc3.${DOMAIN} tgk_dc3;
    dc4.${DOMAIN} tgk_dc4;
    dc5.${DOMAIN} tgk_dc5;
}

# apiws-edge Telegram проверяет Host: браузер ходит на dc<N>.${DOMAIN}, а
# рукопожатие должно нести Host: kws<N>.web.telegram.org.
map $ssl_server_name $kws_host {
    dc1.${DOMAIN} kws1.web.telegram.org;
    dc2.${DOMAIN} kws2.web.telegram.org;
    dc3.${DOMAIN} kws3.web.telegram.org;
    dc4.${DOMAIN} kws4.web.telegram.org;
    dc5.${DOMAIN} kws5.web.telegram.org;
}

# :80 — ACME http-01 (certbot --webroot) и редирект на HTTPS.
server {
    listen 80;
    server_name ${DOMAIN} *.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Веб-вход: админка + /api/* + Telegram Web (/tg/*, WebSocket).
server {
    listen 127.0.0.1:4443 ssl http2 proxy_protocol;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    location / {
        # Внутренний TLS-хоп до nginx шлюза (самоподписанный сертификат —
        # проверка не нужна: клиентский TLS терминируется здесь).
        proxy_pass https://webtgk_up;
        proxy_ssl_verify off;

        # Ответы YouTube/Telegram с большими заголовками.
        proxy_buffer_size 32k;
        proxy_buffers 16 32k;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# DC-мост: TLS здесь, дальше plaintext WebSocket в DC-мост шлюза.
# Без http2: браузерный WebSocket должен идти по HTTP/1.1.
server {
    listen 127.0.0.1:4443 ssl proxy_protocol;
    server_name dc1.${DOMAIN} dc2.${DOMAIN} dc3.${DOMAIN} dc4.${DOMAIN} dc5.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    location / {
        return 410; # DC access now uses authenticated /tg/_gw/dc/ on the main origin.

    }
}
