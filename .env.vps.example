# Окружение прод-стека на VPS (README → «Развёртывание на VPS», docs/deploy/VPS.md).
#
#   cp .env.vps.example .env.vps && chmod 600 .env.vps
#
# Заполняется на машине, с которой выполняется деплой (там же собираются
# образы). scripts/vps/deploy.sh отправляет файл на VPS как <VPS_DIR>/.env.
# В git .env.vps не попадает. Всё, что помечено <...>, нужно заменить.

# ===== Куда деплоить =====
# ssh-адрес VPS (пользователь с правами root или в группе docker + sudo).
VPS_HOST=root@<VPS_IP>
# Путь к ssh-ключу; пусто — ssh-agent / ~/.ssh/config.
VPS_SSH_KEY=
# Каталог стека на VPS.
VPS_DIR=/opt/telegram-gateway

# ===== Домен =====
# Нужны A-записи на IP VPS: DOMAIN, dc1..dc5.DOMAIN, turn.DOMAIN
# (docs/deploy/VPS.md §1). ACME_EMAIL — для Let's Encrypt.
DOMAIN=<gateway.example.com>
ACME_EMAIL=<admin@example.com>

# Производные от домена: замените <gateway.example.com> на DOMAIN.
GATEWAY_URL=https://<gateway.example.com>
DC_REWRITE_DOMAIN=<gateway.example.com>
DC_BRIDGE_WSS_1=dc1.<gateway.example.com>
DC_BRIDGE_WSS_2=dc2.<gateway.example.com>
DC_BRIDGE_WSS_3=dc3.<gateway.example.com>
DC_BRIDGE_WSS_4=dc4.<gateway.example.com>
DC_BRIDGE_WSS_5=dc5.<gateway.example.com>

# ===== Compose =====
# Базовый файл + VPS-профиль (лимиты памяти, порты только на loopback,
# мониторинг выключен).
COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
COMPOSE_PROJECT_NAME=telegram-gateway
# Профили: xray — выход в Telegram через VLESS (см. ниже);
#          monitoring — prometheus/grafana/loki/promtail (+~210 МБ ОЗУ).
COMPOSE_PROFILES=xray

# ===== Секреты =====
# Сгенерировать: openssl rand -hex 24. Деплой откажется от значений из примеров.
POSTGRES_USER=tg
POSTGRES_DB=telegram_gateway
MIGRATE_EXPECT_DB=telegram_gateway
POSTGRES_PASSWORD=<openssl rand -hex 24>
BOT_API_TOKEN=<openssl rand -hex 24>
# Первый администратор создаётся автоматически. Логин и пароль выводятся
# в консоль первого деплоя и в stdout контейнера api.
GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 16>

# ===== Выход в Telegram =====
# Вариант A — VPS вне РФ, Telegram доступен напрямую:
#   COMPOSE_PROFILES=            (без xray)
#   SOCKS5_ADDR=
#   BOT_HTTPS_PROXY=
# Вариант B — Telegram с VPS недоступен: xray-клиент к вашему VLESS+REALITY
# серверу (заполнить XRAY_*):
SOCKS5_ADDR=xray:10808
BOT_HTTPS_PROXY=socks5://xray:10808

# Ссылки vless:// вашего сервера (как в клиенте v2rayN/v2rayA/Hiddify), в
# одинарных кавычках. Поддерживаются type=tcp/xhttp/ws/grpc, security=reality/tls.
# Одна ссылка — весь трафик в неё. Несколько (XRAY_LINK_2, _3, ...) — xray раз
# в минуту проверяет узлы и ведёт трафик через живой с наименьшей задержкой.
XRAY_LINK_1='vless://<uuid>@<server>:443?type=xhttp&security=reality&sni=<sni>&pbk=<pbk>&sid=<sid>&fp=chrome&path=%2F&mode=auto#main'
# XRAY_LINK_2='vless://<uuid>@<server>:8443?type=tcp&security=reality&sni=<sni>&pbk=<pbk>&sid=<sid>&fp=firefox#backup'
# Адрес xray в compose-сети (docker-compose.vps.yml) — для UDP (TURN/STUN).
XRAY_SOCKS_UDP_IP=172.31.250.53

# ===== Telegram-бот (опционально) =====
TG_BOT_ENABLED=false
BOT_REPLICAS=0
BOT_TOKEN=

# ===== TURN-релей для звонков Telegram Web =====
# Пустой TURN_ADDR — релей выключен.
TURN_ADDR=:3478
TURN_SECRET=<openssl rand -hex 32>
TURN_URLS=turns:turn.<gateway.example.com>:443?transport=tcp

LOG_LEVEL=info

# ===== Защита VPS (scripts/vps/harden.sh) =====
# ufw всегда открывает 22 (с ограничением частоты), 80, 443. Дополнительные
# порты хоста через пробел, например для frps: "7000/tcp 7000/udp".
UFW_EXTRA_ALLOW=

# ===== Домашний сервер за NAT (опционально, docs/deploy/HOME.md) =====
# Если стек можно запускать и дома с доступом через frp-туннель на этот VPS:
# порты frps на VPS, в которые frpc доставляет веб-вход, DC-мост и TURN.
INGRESS_HOME_WEB=127.0.0.1:15443
INGRESS_HOME_DC1=127.0.0.1:20011
INGRESS_HOME_DC2=127.0.0.1:20012
INGRESS_HOME_DC3=127.0.0.1:20013
INGRESS_HOME_DC4=127.0.0.1:20014
INGRESS_HOME_DC5=127.0.0.1:20015
INGRESS_HOME_TURN=127.0.0.1:36005

# Optional encrypted offsite backups. Initialize the restic repository first.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
